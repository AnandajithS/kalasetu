# Server configuration
PORT=8080

# Database configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=kalasetu_db
DB_SSLMODE=disable

# JWT secrets for Auth
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here

# Object storage (AWS S3) for post media uploads

AWS_REGION=ap-south-1
AWS_BUCKET=kalasetu-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
API_BASE_URL=http://your_backend_url:8080
