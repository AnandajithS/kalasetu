# Server configuration
PORT=8080

# Database configuration (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=kalasetu_db
DB_SSLMODE=disable

# JWT secrets for Auth
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here

# Object storage (AWS S3) for post media uploads
#
# Required whenever a user uploads media in a post. When AWS_BUCKET is left
# empty, the server starts without object storage and posts are limited to
# text-only (media uploads return an error).
#
# AWS_REGION / AWS_BUCKET are read directly by the app. Credentials are
# resolved automatically by the AWS SDK default credential chain, so only the
# standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY variables (or an IAM role,
# web identity / container credential provider) are needed.
AWS_REGION=ap-south-1
AWS_BUCKET=kalasetu-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
